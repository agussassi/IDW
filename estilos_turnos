body {
    background-color: #f5f5f5;
    color: #333;
    font-family: Arial, sans-serif;
}


.navbar-brand {
    font-size: 1.25rem;
}


.nav-link {
    margin-left: 8px;
}


.nav-link:hover {
    color: #198754 !important;
}


.contacto-card {
    background-color: #ffffff;
}


.dato-contacto {
    border-bottom: 1px solid #e9e9e9;
    padding-bottom: 15px;
}


.dato-contacto:last-child {
    border-bottom: none;
}


.card {
    border-radius: 14px;
}


.form-control,
.form-select {
    border-radius: 8px;
    padding: 10px 12px;
}


.btn-success {
    border-radius: 8px;
}


footer {
    margin-top: 20px;
}


@media (max-width: 768px) {

    .nav-link {
        margin-left: 0;
    }

    h1 {
        font-size: 2rem;
    }

}

